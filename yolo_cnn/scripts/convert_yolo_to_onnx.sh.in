export RESOLUTION_W=$1
export RESOLUTION_H=$2
if [ ! -z "@HTTPS_PROXY_STR@" ]; then
    export @HTTPS_PROXY_STR@
fi
source python_env/bin/activate
python3 @CMAKE_CURRENT_SOURCE_DIR@/yolov8n_onnx.py ${RESOLUTION_W} ${RESOLUTION_H}
cp *categories.txt @INSTALL_PREFIX@
