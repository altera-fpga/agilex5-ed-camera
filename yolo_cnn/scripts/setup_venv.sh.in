if [ ! -z "@HTTPS_PROXY_STR@" ]; then
    export @HTTPS_PROXY_STR@
fi
export _PIP_LOCATIONS_NO_WARN_ON_MISMATCH=1
python3 -m venv python_env
source python_env/bin/activate
python3 -m pip install --upgrade pip
python3 -m pip install -r @CMAKE_CURRENT_SOURCE_DIR@/requirements.txt  --extra-index-url https://download.pytorch.org/whl/cpu
