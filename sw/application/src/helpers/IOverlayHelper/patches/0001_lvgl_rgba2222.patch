+    bg.red = (uint32_t)((uint32_t)fg.red * fg.alpha + (uint32_t)bg.red * (3 - fg.alpha)) >> 2;
+    bg.green = (uint32_t)((uint32_t)fg.green * fg.alpha + (uint32_t)bg.green * (3 - fg.alpha)) >> 2;
+    bg.blue = (uint32_t)((uint32_t)fg.blue * fg.alpha + (uint32_t)bg.blue * (3 - fg.alpha)) >> 2;
+    return bg;
+}
+
+static void transform_argb2222(const uint8_t * src, int32_t src_w, int32_t src_h, int32_t src_stride,
+                               int32_t xs_ups, int32_t ys_ups, int32_t xs_step, int32_t ys_step,
+                               int32_t x_end, uint8_t * dest_buf, bool aa)
+{
+    int32_t xs_ups_start = xs_ups;
+    int32_t ys_ups_start = ys_ups;
+    lv_color8a_t * dest_c8 = (lv_color8a_t *) dest_buf;
+
+    int32_t x;
+    for(x = 0; x < x_end; x++) {
+        xs_ups = xs_ups_start + ((xs_step * x) >> 8);
+        ys_ups = ys_ups_start + ((ys_step * x) >> 8);
+
+        int32_t xs_int = xs_ups >> 8;
+        int32_t ys_int = ys_ups >> 8;
+
+        /*Fully out of the image*/
+        if(xs_int < 0 || xs_int >= src_w || ys_int < 0 || ys_int >= src_h) {
+            ((uint32_t *)dest_buf)[x] = 0x00;
+            continue;
+        }
+
+        /*Get the direction the hor and ver neighbor
+         *`fract` will be in range of 0x00..0xFF and `next` (+/-1) indicates the direction*/
+        int32_t xs_fract = xs_ups & 0xFF;
+        int32_t ys_fract = ys_ups & 0xFF;
+
+        int32_t x_next;
+        int32_t y_next;
+        if(xs_fract < 0x80) {
+            x_next = -1;
+            xs_fract = 0x7F - xs_fract;
+        }
+        else {
+            x_next = 1;
+            xs_fract = xs_fract - 0x80;
+        }
+        if(ys_fract < 0x80) {
+            y_next = -1;
+            ys_fract = 0x7F - ys_fract;
+        }
+        else {
+            y_next = 1;
+            ys_fract = ys_fract - 0x80;
+        }
+
+        const lv_color8a_t * src_c8 = (const lv_color8a_t *)(src + ys_int * src_stride + xs_int);
+
+        dest_c8[x] = src_c8[0];
+
+        if(aa &&
+           xs_int + x_next >= 0 &&
+           xs_int + x_next <= src_w - 1 &&
+           ys_int + y_next >= 0 &&
+           ys_int + y_next <= src_h - 1) {
+
+            lv_color8a_t px_hor = src_c8[x_next];
+            lv_color8a_t px_ver = *(const lv_color8a_t *)((uint8_t *)src_c8 + y_next * src_stride);
+
+            if(px_ver.alpha == 0) {
+                dest_c8[x].alpha = (dest_c8[x].alpha * (0xFF - ys_fract)) >> 8;
+            }
+            else if(!lv_color8a_eq(dest_c8[x], px_ver)) {
+                if(dest_c8[x].alpha) dest_c8[x].alpha = ((px_ver.alpha * ys_fract) + (dest_c8[x].alpha * (0xFF - ys_fract))) >> 8;
+                px_ver.alpha = ys_fract >> 6;
+                dest_c8[x] = lv_color_mix8a(px_ver, dest_c8[x]);
+            }
+
+            if(px_hor.alpha == 0) {
+                dest_c8[x].alpha = (dest_c8[x].alpha * (0xFF - xs_fract)) >> 8;
+            }
+            else if(!lv_color8a_eq(dest_c8[x], px_hor)) {
+                if(dest_c8[x].alpha) dest_c8[x].alpha = ((px_hor.alpha * xs_fract) + (dest_c8[x].alpha * (0xFF - xs_fract))) >> 8;
+                px_hor.alpha = xs_fract >> 6;
+                dest_c8[x] = lv_color_mix8a(px_hor, dest_c8[x]);
+            }
+        }
+        /*Partially out of the image*/
+        else {
+            if((xs_int == 0 && x_next < 0) || (xs_int == src_w - 1 && x_next > 0))  {
+                dest_c8[x].alpha = (dest_c8[x].alpha * (0x7F - xs_fract)) >> 7;
+            }
+            else if((ys_int == 0 && y_next < 0) || (ys_int == src_h - 1 && y_next > 0))  {
+                dest_c8[x].alpha = (dest_c8[x].alpha * (0x7F - ys_fract)) >> 7;
+            }
+        }
+    }
 }
 
