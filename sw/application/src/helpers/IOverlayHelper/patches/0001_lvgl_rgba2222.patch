+                src_argb.red = src_buf_c8[x].red << 6;
+                src_argb.green = src_buf_c8[x].green << 6;
+                src_argb.blue = src_buf_c8[x].blue << 6;
+                if(mask_buf == NULL) src_argb.alpha = LV_OPA_MIX2(src_buf_c8[x].alpha << 6, opa);
