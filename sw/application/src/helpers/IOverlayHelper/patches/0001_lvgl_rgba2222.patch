+static inline lv_color8a_t LV_ATTRIBUTE_FAST_MEM lv_color_mix8a(lv_color8a_t fg, lv_color8a_t bg)
+{
+    if(fg.alpha >= 3) {
+        fg.alpha = bg.alpha;
+        return fg;
+    }
+    if(fg.alpha <= 0) {
+        return bg;
+    }
+    bg.red = (uint32_t)((uint32_t)fg.red * fg.alpha + (uint32_t)bg.red * (3 - fg.alpha) + 1) / 3;
+    bg.green = (uint32_t)((uint32_t)fg.green * fg.alpha + (uint32_t)bg.green * (3 - fg.alpha) + 1) / 3;
+    bg.blue = (uint32_t)((uint32_t)fg.blue * fg.alpha + (uint32_t)bg.blue * (3 - fg.alpha) + 1) / 3;
+    return bg;
+}
+
+static inline void LV_ATTRIBUTE_FAST_MEM lv_color_8a_8a_mix(lv_color8a_t fg, lv_color8a_t * bg,
+                                                              lv_color_mix_alpha_cache_t * cache)
+{
+    /*Pick the foreground if it's fully opaque or the Background is fully transparent*/
+    if(fg.alpha >= 3 || bg->alpha <= 0) {
+        *bg = fg;
+    }
+    /*Transparent foreground: use the Background*/
+    else if(fg.alpha <= 0) {
+        /* no need to copy */
+    }
+    /*Opaque background: use simple mix*/
+    else if(bg->alpha == 3) {
+        *bg = lv_color_mix8a(fg, *bg);
+    }
+    /*Both colors have alpha. Expensive calculation needs to be applied*/
+    else {
+        /*Save the parameters and the result. If they will be asked again don't compute again*/
+
+        /*Update the ratio and the result alpha value if the input alpha values change*/
+        if(bg->alpha != cache->bg_saved.alpha || fg.alpha != cache->fg_saved.alpha) {
+            /*Info:
+             * https://en.wikipedia.org/wiki/Alpha_compositing#Analytical_derivation_of_the_over_operator*/
+            cache->res_alpha_saved = 3 - LV_OPA_MIX2(255 - (fg.alpha << 6), 255 - (bg->alpha << 6)) >> 6;
+            LV_ASSERT(cache->res_alpha_saved != 0);
+            cache->ratio_saved = (uint32_t)((uint32_t)(fg.alpha) * 3) / cache->res_alpha_saved;
+        }
+
+        if(!lv_color8a_eq(*bg, cache->bg_saved) || !lv_color8a_eq(fg, cache->fg_saved)) {
+            cache->fg_saved = fg;
+            cache->bg_saved = *bg;
+            fg.alpha = cache->ratio_saved ;
+            cache->res_saved = lv_color_mix8a(fg, *bg);
+            cache->res_saved.alpha = cache->res_alpha_saved;
+        }
+
+        *bg = cache->res_saved;
+    }
+}
+
+void lv_color_mix_with_alpha_cache_init(lv_color_mix_alpha_cache_t * cache)
+{
+    lv_memzero(&cache->fg_saved, sizeof(lv_color8a_t));
+    lv_memzero(&cache->bg_saved, sizeof(lv_color8a_t));
+    lv_memzero(&cache->res_saved, sizeof(lv_color8a_t));
+    cache->res_alpha_saved = 3;
+    cache->ratio_saved = 3;
+}
