+#if LV_DRAW_SW_SUPPORT_I1
+static void LV_ATTRIBUTE_FAST_MEM i1_image_blend(lv_draw_sw_blend_image_dsc_t * dsc)
+{
+    int32_t w = dsc->dest_w;
+    int32_t h = dsc->dest_h;
+    lv_opa_t opa = dsc->opa;
+    lv_color8a_t * dest_buf_argb2222 = dsc->dest_buf;
+    int32_t dest_stride = dsc->dest_stride;
+    const uint8_t * src_buf_i1 = dsc->src_buf;
+    int32_t src_stride = dsc->src_stride;
+    const lv_opa_t * mask_buf = dsc->mask_buf;
+    int32_t mask_stride = dsc->mask_stride;
+
+    lv_color_mix_alpha_cache_t cache;
+    lv_color_mix_with_alpha_cache_init(&cache);
+
+    int32_t x, y;
+
+    if(dsc->blend_mode == LV_BLEND_MODE_NORMAL) {
+        if(mask_buf == NULL && opa >= LV_OPA_MAX) {
+            if(LV_RESULT_INVALID == LV_DRAW_SW_I1_BLEND_NORMAL_TO_ARGB2222(dsc)) {
+                for(y = 0; y < h; y++) {
+                    for(x = 0; x < w; x++) {
+                        dest_buf_argb2222[x].red = get_bit(src_buf_i1, x) * 3;
+                        dest_buf_argb2222[x].green = get_bit(src_buf_i1, x) * 3;
+                        dest_buf_argb2222[x].blue = get_bit(src_buf_i1, x) * 3;
+                        dest_buf_argb2222[x].alpha = 3;
+                    }
+                    dest_buf_argb2222 = drawbuf_next_row(dest_buf_argb2222, dest_stride);
+                    src_buf_i1 = drawbuf_next_row(src_buf_i1, src_stride);
+                }
+            }
+        }
+        else if(mask_buf == NULL && opa < LV_OPA_MAX) {
+            if(LV_RESULT_INVALID == LV_DRAW_SW_I1_BLEND_NORMAL_TO_ARGB2222_WITH_OPA(dsc)) {
+                for(y = 0; y < h; y++) {
+                    for(x = 0; x < w; x++) {
+                        lv_color8a_t src_color;
+                        src_color.red = get_bit(src_buf_i1, x) * 3;
+                        src_color.green = get_bit(src_buf_i1, x) * 3;
+                        src_color.blue = get_bit(src_buf_i1, x) * 3;
+                        src_color.alpha = opa >> 6;
+                        lv_color_8a_8a_mix(src_color, &dest_buf_argb2222[x], &cache);
+                    }
+                    dest_buf_argb2222 = drawbuf_next_row(dest_buf_argb2222, dest_stride);
+                    src_buf_i1 = drawbuf_next_row(src_buf_i1, src_stride);
+                }
+            }
+        }
+        else if(mask_buf && opa >= LV_OPA_MAX) {
+            if(LV_RESULT_INVALID == LV_DRAW_SW_I1_BLEND_NORMAL_TO_ARGB2222_WITH_MASK(dsc)) {
+                for(y = 0; y < h; y++) {
+                    for(x = 0; x < w; x++) {
+                        lv_color8a_t src_color;
+                        src_color.red = get_bit(src_buf_i1, x) * 3;
+                        src_color.green = get_bit(src_buf_i1, x) * 3;
+                        src_color.blue = get_bit(src_buf_i1, x) * 3;
+                        src_color.alpha = mask_buf[x] >> 6;
+                        lv_color_8a_8a_mix(src_color, &dest_buf_argb2222[x], &cache);
+                    }
+                    dest_buf_argb2222 = drawbuf_next_row(dest_buf_argb2222, dest_stride);
+                    src_buf_i1 = drawbuf_next_row(src_buf_i1, src_stride);
+                    mask_buf += mask_stride;
+                }
+            }
+        }
+        else if(mask_buf && opa < LV_OPA_MAX) {
+            if(LV_RESULT_INVALID == LV_DRAW_SW_I1_BLEND_NORMAL_TO_ARGB2222_MIX_MASK_OPA(dsc)) {
+                for(y = 0; y < h; y++) {
+                    for(x = 0; x < w; x++) {
+                        lv_color8a_t src_color;
+                        src_color.red = get_bit(src_buf_i1, x) * 3;
+                        src_color.green = get_bit(src_buf_i1, x) * 3;
+                        src_color.blue = get_bit(src_buf_i1, x) * 3;
+                        src_color.alpha = LV_OPA_MIX2(mask_buf[x], opa) >> 6;
+                        lv_color_8a_8a_mix(src_color, &dest_buf_argb2222[x], &cache);
+                    }
+                    dest_buf_argb2222 = drawbuf_next_row(dest_buf_argb2222, dest_stride);
+                    src_buf_i1 = drawbuf_next_row(src_buf_i1, src_stride);
+                    mask_buf += mask_stride;
+                }
+            }
+        }
+        else {
+            for(y = 0; y < h; y++) {
+                for(x = 0; x < w; x++) {
+                    lv_color8a_t src_color;
+                    src_color.red = get_bit(src_buf_i1, x) * 3;
+                    src_color.green = get_bit(src_buf_i1, x) * 3;
+                    src_color.blue = get_bit(src_buf_i1, x) * 3;
+                    if(mask_buf == NULL) src_color.alpha = opa >> 6;
+                    else src_color.alpha = LV_OPA_MIX2(mask_buf[x], opa) >> 6;
+                    blend_non_normal_pixel(&dest_buf_argb2222[x], src_color, dsc->blend_mode, &cache);
+                }
+                if(mask_buf) mask_buf += mask_stride;
+                dest_buf_argb2222 = drawbuf_next_row(dest_buf_argb2222, dest_stride);
+                src_buf_i1 = drawbuf_next_row(src_buf_i1, src_stride);
+            }
+        }
+    }
+}
