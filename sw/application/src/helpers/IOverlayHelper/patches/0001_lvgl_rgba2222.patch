+
+static inline void LV_ATTRIBUTE_FAST_MEM blend_non_normal_pixel(lv_color8a_t * dest, lv_color8a_t src,
+                                                                lv_blend_mode_t mode, lv_color_mix_alpha_cache_t * cache)
+{
+    lv_color8a_t res;
+    switch(mode) {
+        case LV_BLEND_MODE_ADDITIVE:
+            res.red = LV_MIN(dest->red + src.red, 3);
+            res.green = LV_MIN(dest->green + src.green, 3);
+            res.blue = LV_MIN(dest->blue + src.blue, 3);
+            break;
+        case LV_BLEND_MODE_SUBTRACTIVE:
+            res.red = LV_MAX(dest->red - src.red, 0);
+            res.green = LV_MAX(dest->green - src.green, 0);
+            res.blue = LV_MAX(dest->blue - src.blue, 0);
+            break;
+        case LV_BLEND_MODE_MULTIPLY:
+            res.red = (dest->red * src.red) >> 8;
+            res.green = (dest->green * src.green) >> 8;
+            res.blue = (dest->blue * src.blue) >> 8;
+            break;
+        default:
+            LV_LOG_WARN("Not supported blend mode: %d", mode);
+            return;
+    }
+    res.alpha = src.alpha;
+    lv_color_8a_8a_mix(res, dest, cache);
+}
