+void LV_ATTRIBUTE_FAST_MEM lv_draw_sw_blend_color_to_argb2222(lv_draw_sw_blend_fill_dsc_t * dsc)
+{
+    int32_t w = dsc->dest_w;
+    int32_t h = dsc->dest_h;
+    lv_opa_t opa = dsc->opa;
+    const lv_opa_t * mask = dsc->mask_buf;
+    int32_t mask_stride = dsc->mask_stride;
+    int32_t dest_stride = dsc->dest_stride;
+
+    lv_color_mix_alpha_cache_t cache;
+    lv_color_mix_with_alpha_cache_init(&cache);
+
+    int32_t x;
+    int32_t y;
+
+    LV_UNUSED(w);
+    LV_UNUSED(h);
+    LV_UNUSED(x);
+    LV_UNUSED(y);
+    LV_UNUSED(opa);
+    LV_UNUSED(mask);
+    LV_UNUSED(mask_stride);
+    LV_UNUSED(dest_stride);
+
+    /*Simple fill*/
+    if(mask == NULL && opa >= LV_OPA_MAX) {
+        if(LV_RESULT_INVALID == LV_DRAW_SW_COLOR_BLEND_TO_ARGB2222(dsc)) {
+            lv_color8a_t color8a;
+            color8a.red = dsc->color.red >> 6;
+            color8a.green = dsc->color.green >> 6;
+            color8a.blue = dsc->color.blue >> 6;
+            color8a.alpha = 3;
+            lv_color8a_t * dest_buf = dsc->dest_buf;
+            for(y = 0; y < h; y++) {
+                for(x = 0; x < w - 16; x += 16) {
+                    dest_buf[x + 0] = color8a;
+                    dest_buf[x + 1] = color8a;
+                    dest_buf[x + 2] = color8a;
+                    dest_buf[x + 3] = color8a;
+
+                    dest_buf[x + 4] = color8a;
+                    dest_buf[x + 5] = color8a;
+                    dest_buf[x + 6] = color8a;
+                    dest_buf[x + 7] = color8a;
+
+                    dest_buf[x + 8] = color8a;
+                    dest_buf[x + 9] = color8a;
+                    dest_buf[x + 10] = color8a;
+                    dest_buf[x + 11] = color8a;
+
+                    dest_buf[x + 12] = color8a;
+                    dest_buf[x + 13] = color8a;
+                    dest_buf[x + 14] = color8a;
+                    dest_buf[x + 15] = color8a;
+                }
+                for(; x < w; x ++) {
+                    dest_buf[x] = color8a;
+                }
+
+                dest_buf = drawbuf_next_row(dest_buf, dest_stride);
+            }
+        }
+    }
+    /*Opacity only*/
+    else if(mask == NULL && opa < LV_OPA_MAX) {
+        if(LV_RESULT_INVALID == LV_DRAW_SW_COLOR_BLEND_TO_ARGB2222_WITH_OPA(dsc)) {
+            lv_color8a_t color8a;
+            color8a.red = dsc->color.red >> 6;
+            color8a.green = dsc->color.green >> 6;
+            color8a.blue = dsc->color.blue >> 6;
+            color8a.alpha = 3;
+            lv_color8a_t * dest_buf = dsc->dest_buf;
+            for(y = 0; y < h; y++) {
+                for(x = 0; x < w; x++) {
+                    lv_color_8a_8a_mix(color8a, &dest_buf[x], &cache);
+                }
+                dest_buf = drawbuf_next_row(dest_buf, dest_stride);
+            }
+        }
+
+    }
+    /*Masked with full opacity*/
+    else if(mask && opa >= LV_OPA_MAX) {
+        if(LV_RESULT_INVALID == LV_DRAW_SW_COLOR_BLEND_TO_ARGB2222_WITH_MASK(dsc)) {
+            lv_color8a_t color8a;
+            color8a.red = dsc->color.red >> 6;
+            color8a.green = dsc->color.green >> 6;
+            color8a.blue = dsc->color.blue >> 6;
+            lv_color8a_t * dest_buf = (lv_color8a_t *)dsc->dest_buf;
+            for(y = 0; y < h; y++) {
+                for(x = 0; x < w; x++) {
+                    color8a.alpha = mask[x] >> 6;
+                    lv_color_8a_8a_mix(color8a, &dest_buf[x], &cache);
+                }
+                dest_buf = drawbuf_next_row(dest_buf, dest_stride);
+                mask += mask_stride;
+            }
+        }
+
+    }
+    /*Masked with opacity*/
+    else {
+        if(LV_RESULT_INVALID == LV_DRAW_SW_COLOR_BLEND_TO_ARGB2222_MIX_MASK_OPA(dsc)) {
+            lv_color8a_t color8a;
+            color8a.red = dsc->color.red >> 6;
+            color8a.green = dsc->color.green >> 6;
+            color8a.blue = dsc->color.blue >> 6;
+            lv_color8a_t * dest_buf = (lv_color8a_t *)dsc->dest_buf;
+            for(y = 0; y < h; y++) {
+                for(x = 0; x < w; x++) {
+                    color8a.alpha = LV_OPA_MIX2(mask[x], opa) >> 6;
+                    lv_color_8a_8a_mix(color8a, &dest_buf[x], &cache);
+                }
+                dest_buf = drawbuf_next_row(dest_buf, dest_stride);
+                mask += mask_stride;
+            }
+        }
+    }
+}
