 }
+#else
+template <typename In, typename Out>
+static inline void outputConvolutionTransformationTable(const void* const& in_,
+                                                        void* const& out_,
+                                                        const std::uint32_t* inIdxs,
+                                                        const GraphData& graphData,
+                                                        const OutputTransformation::Data& outputData) {
+  const std::uint32_t* inIdx = inIdxs;
+  auto in = static_cast<const In* const>(in_);
+  auto out = static_cast<Out* const>(out_);
+  for(size_t i = 0; i < outputData._rawSize; i++)
+  {
+    union FP32 {
+      std::uint16_t u;
+      __fp16 f;
+    };
+
+    FP32 res;
+    res.u = in[*inIdx];
+    *out = res.f;
+
+    inIdx++;
+    out++;
+  }
+}
+#endif
 
